{
  "name": "handular",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm --dir api run prisma db push",
    "db:migrate": "pnpm --dir api run prisma:migrate",
    "db:studio": "pnpm --dir api run prisma:studio",
    "seed": "pnpm --dir api run seed",
    "build": "pnpm --dir api run build && pnpm --dir client run build && pnpm --dir admin run build",
    "build:api": "pnpm --dir api run build",
    "build:client": "pnpm --dir client run build",
    "build:admin": "pnpm --dir admin run build",
    "dev:api": "pnpm --dir api run dev",
    "dev:client": "pnpm --dir client run dev",
    "dev:admin": "pnpm --dir admin run dev"
  }
}
